 PARAMETER G(FCC_A1,FE,SI:VA;2) 298.15 +19706.6; 6000 N ! $ Feng T5 [23]
$ ----- BCC_A2 -----
PHASE BCC_A2 %& 2 1 3 !
CONSTITUENT BCC_A2 : LA,FE,SI : VA : !
 PARAMETER G(BCC_A2,LA:VA;0) 298.15 +GLABCC#; 6000 N ! $ unary
 PARAMETER G(BCC_A2,FE:VA;0) 298.15 +GHSERFE#; 6000 N ! $ unary (bcc SER)
 PARAMETER G(BCC_A2,SI:VA;0) 298.15 +GSIBCC#; 6000 N ! $ unary
 PARAMETER TC(BCC_A2,FE:VA;0) 298.15 +1043; 6000 N ! $ Feng T5 [23]
 PARAMETER BMAGN(BCC_A2,FE:VA;0) 298.15 +2.22; 6000 N ! $ Feng T5 [23]
 PARAMETER TC(BCC_A2,FE,SI:VA;1) 298.15 +504; 6000 N ! $ Feng T5 [23]
 PARAMETER BMAGN(BCC_A2,FE,SI:VA;1) 298.15 +1.07; 6000 N ! $ Feng T5 [23]
 PARAMETER G(BCC_A2,LA,FE:VA;0) 298.15 +45319.444; 6000 N ! $ Feng T5 [24]
 PARAMETER G(BCC_A2,LA,SI:VA;0) 298.15 -202356.5; 6000 N ! $ Feng T5 [20]
 PARAMETER G(BCC_A2,FE,SI:VA;0) 298.15 -180000.0+47.8494*T; 6000 N ! $ Feng T5 [23]
 PARAMETER G(BCC_A2,FE,SI:VA;1) 298.15 -32198.0; 6000 N ! $ Feng T5 [23]
 PARAMETER G(BCC_A2,FE,SI:VA;2) 298.15 +15882.8; 6000 N ! $ Feng T5 [23]
$ ----- DIAMOND_A4 -----
PHASE DIAMOND_A4 % 1 1.0 !
CONSTITUENT DIAMOND_A4 : SI : !
 PARAMETER G(DIAMOND_A4,SI;0) 298.15 +GHSERSI#; 6000 N ! $ unary (diamond SER)
$ ----- Fe-Si line compounds (Feng T5 [23]) -----
PHASE FE2SI % 2 0.66667 0.33333 !
CONSTITUENT FE2SI : FE : SI : !
 PARAMETER G(FE2SI,FE:SI;0) 298.15 +-30592.9+0.33333*GHSERSI#+0.66667*GHSERFE#; 6000 N ! $ Feng T5 [23]
PHASE FE5SI3 % 2 0.625 0.375 !
