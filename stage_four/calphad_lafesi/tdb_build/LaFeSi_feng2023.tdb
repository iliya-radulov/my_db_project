$ ============================================================
$ La-Fe-Si -- reconstruction of Feng et al., Calphad 83 (2023) 102643
$ Ternary + binary-excess parameters typed from the paper's Table 5.
$ Unaries: SGTE/Dinsdale 1991 (see build_tdb.py, FROZEN_SPEC.md).
$ Scope: LIQUID, FCC_A1, BCC_A2, DIAMOND_A4, Fe-Si compounds,
$        La-Si(Fe) compounds, tau1/tau2 = La(Fe,Si)13.
$ Deferred: tau3-tau6, Fe-Si B2/D03 ordering.
$ ============================================================
ELEMENT VA   VACUUM               0.0      0.0      0.0    !
ELEMENT LA   DOUBLE_HCP(ABAC)   138.9055  6667.0   57.488 !
ELEMENT FE   BCC_A2              55.847    4489.0   27.28  !
ELEMENT SI   DIAMOND_A4          28.0855   3217.0   18.81  !

TYPE_DEFINITION % SEQ * !
DEFINE_SYSTEM_DEFAULT ELEMENT 2 !
DEFAULT_COMMAND DEFINE_SYSTEM_ELEMENT VA !

TYPE_DEFINITION & GES AMEND_PHASE_DESCRIPTION BCC_A2 MAGNETIC -1.0 0.4 !
TYPE_DEFINITION ) GES AMEND_PHASE_DESCRIPTION FCC_A1 MAGNETIC -3.0 0.28 !

$ ===== SGTE / Dinsdale 1991 unary functions (verbatim; verified across sources, FROZEN_SPEC §1) =====
FUNCTION GHSERLA 2.98140E+02 -7968.403+120.284604*T -26.34*T*LN(T)-.001295165*T**2; 5.50000E+02 Y -3381.413+59.06113*T-17.1659411*T*LN(T)-.008371705*T**2 +6.8932E-07*T**3-399448*T**(-1); 2.00000E+03 Y -15608.882+181.390071*T-34.3088*T*LN(T); 4.00000E+03 N !
FUNCTION GLABCC 2.98140E+02 -3952.161+88.072353*T -21.7919*T*LN(T)-.004045175*T**2-5.25865E-07*T**3; 8.00000E+02 Y +321682.673-3565.08252*T+513.440708*T*LN(T) -.387295093*T**2 +4.9547989E-05*T**3-36581228*T**(-1); 1.13400E+03 Y -16377.894+218.492988*T-39.5388*T*LN(T); 1.19300E+03 Y -136609.91+1123.34397*T-163.413074*T*LN(T) +.053968535*T**2 -4.056395E-06*T**3+21167204*T**(-1); 2.00000E+03 Y -8205.988+174.836315*T-34.3088*T*LN(T); 4.00000E+03 N !
FUNCTION GLAFCC 2.98140E+02 -6109.797+89.878761*T -21.7919*T*LN(T) -.004045175*T**2-5.25865E-07*T**3; 1.13400E+03 Y -124598.976+955.878375*T-139.346741*T*LN(T)+.042032405*T**2 -3.066199E-06*T**3+20994153*T**(-1); 2.00000E+03 Y -12599.386+178.54399*T-34.3088*T*LN(T); 4.00000E+03 N !
FUNCTION GLALIQ 2.98140E+02 +5332.653+18.23012*T -11.0188191*T*LN(T) -.020171603*T**2+2.93775E-06*T**3-133541*T**(-1); 1.13400E+03 Y -3942.004+171.018431*T-34.3088*T*LN(T); 4.00000E+03 N !
FUNCTION GHSERFE 298.15 1225.7-0.00439752*T**(2)-23.5143*T*LOG(T) +77359.0*T**(-1)-5.8927E-08*T**(3)+124.134*T; 1811.0 Y -25383.581 +2.29603E+31*T**(-9)-46.0*T*LOG(T)+299.31255*T; 6000.0 N !
FUNCTION GFCCFE 298.15 -1462.4+GHSERFE+0.00064*T**(2)-1.15*T*LOG(T)+8.282*T; 1811.0 Y -1713.815+4.9251E+30*T**(-9)+GHSERFE+0.940009*T; 6000.0 N !
FUNCTION GLIQFE 2.98150E+02 +GHSERFE#+12040.17-6.55843*T -3.67516E-21*T**7; 1.81100E+03 Y -10838.83+291.302*T-46*T*LN(T); 6.00000E+03 N !
FUNCTION GHSERSI 298.15 -8162.609+137.236859*T-22.8317533*T*LOG(T) -1.912904E-3*T**2-0.003552E-6*T**3 +176667*T**(-1); 1687.00 Y -9457.642+167.281367*T-27.196*T*LOG(T) -420.369E28*T**(-9); 3600.00 N !
FUNCTION GSIBCC 273.0 -22.5*T + GHSERSI# + 47000; 6000.0 N !
FUNCTION GSIFCC 273.0 -21.8*T + GHSERSI# + 51000; 6000.0 N !
FUNCTION GLIQSI 298.15 +50696.4-30.0994*T+2.09307E-21*T**7+GHSERSI#; 1687.00 Y +49828.2-29.5591*T+4.20369E+30*T**(-9)+GHSERSI#; 6000.00 N !
$ Feng notation: GHCP_La = dhcp-La SER = GHSERLA; GDIA_Si = diamond-Si SER = GHSERSI; GBCC_Fe = bcc-Fe SER = GHSERFE
$ ----- LIQUID -----
PHASE LIQUID % 1 1.0 !
CONSTITUENT LIQUID : LA,FE,SI : !
 PARAMETER G(LIQUID,LA;0) 298.15 +GLALIQ#; 6000 N ! $ unary
 PARAMETER G(LIQUID,FE;0) 298.15 +GLIQFE#; 6000 N ! $ unary
 PARAMETER G(LIQUID,SI;0) 298.15 +GLIQSI#; 6000 N ! $ unary
 PARAMETER G(LIQUID,LA,FE;0) 298.15 +19054.390+2.3114202*T; 6000 N ! $ Feng T5 [24]
 PARAMETER G(LIQUID,LA,FE;1) 298.15 +22910.538-10.052670*T; 6000 N ! $ Feng T5 [24]
 PARAMETER G(LIQUID,LA,FE;2) 298.15 +8497.879; 6000 N ! $ Feng T5 [24]
 PARAMETER G(LIQUID,LA,SI;0) 298.15 -249912.5-39.85*T; 6000 N ! $ Feng T5 [20]
 PARAMETER G(LIQUID,LA,SI;1) 298.15 +25123.5; 6000 N ! $ Feng T5 [20]
 PARAMETER G(LIQUID,LA,SI;2) 298.15 +83012.5; 6000 N ! $ Feng T5 [20]
 PARAMETER G(LIQUID,LA,SI;3) 298.15 -21695.6; 6000 N ! $ Feng T5 [20]
 PARAMETER G(LIQUID,FE,SI;0) 298.15 -150802.2+24.9159*T; 6000 N ! $ Feng T5 [23]
 PARAMETER G(LIQUID,FE,SI;1) 298.15 -22532.7; 6000 N ! $ Feng T5 [23]
 PARAMETER G(LIQUID,FE,SI;2) 298.15 +23530.4; 6000 N ! $ Feng T5 [23]
 PARAMETER G(LIQUID,LA,FE,SI;0) 298.15 +200000; 6000 N ! $ Feng T5 THIS WORK
$ ----- FCC_A1 -----
PHASE FCC_A1 %) 2 1 1 !
CONSTITUENT FCC_A1 : LA,FE,SI : VA : !
 PARAMETER G(FCC_A1,LA:VA;0) 298.15 +GLAFCC#; 6000 N ! $ unary
 PARAMETER G(FCC_A1,FE:VA;0) 298.15 +GFCCFE#; 6000 N ! $ unary
 PARAMETER G(FCC_A1,SI:VA;0) 298.15 +GSIFCC#; 6000 N ! $ unary
 PARAMETER TC(FCC_A1,FE:VA;0) 298.15 -201; 6000 N ! $ Feng T5 [23]
 PARAMETER BMAGN(FCC_A1,FE:VA;0) 298.15 -2.1; 6000 N ! $ Feng T5 [23]
 PARAMETER G(FCC_A1,LA,FE:VA;0) 298.15 +60142.574-9.7517685*T; 6000 N ! $ Feng T5 [24]
 PARAMETER G(FCC_A1,LA,SI:VA;0) 298.15 -191235.4; 6000 N ! $ Feng T5 [20]
 PARAMETER G(FCC_A1,FE,SI:VA;0) 298.15 -167164.9+42.9734*T; 6000 N ! $ Feng T5 [23]
