# ============================================
# NEW: Convert between atomic % and weight %
# ============================================

def at_to_wt(at_composition: Dict[str, float]) -> Dict[str, float]:
    """
    Convert atomic percent to weight percent.
    
    Args:
        at_composition: {'Fe': 65.0, 'Nd': 30.0, 'Co': 5.0}
    
    Returns:
        wt_composition: {'Fe': 61.4, 'Nd': 30.8, 'Co': 5.2}
    """
    total_at = sum(at_composition.values())
    if abs(total_at - 100) > 0.01:
        # Normalize to 100%
        at_composition = {k: v / total_at * 100 for k, v in at_composition.items()}
    
    # Calculate mass contribution of each element
    mass_contrib = {}
    total_mass = 0.0
    for symbol, at_pct in at_composition.items():
        if symbol not in ATOMIC_WEIGHTS:
            raise ValueError(f"Unknown element: {symbol}")
        weight = at_pct * ATOMIC_WEIGHTS[symbol]
        mass_contrib[symbol] = weight
        total_mass += weight
    
    # Convert to weight percent
    wt_composition = {}
    for symbol, weight in mass_contrib.items():
        wt_composition[symbol] = (weight / total_mass) * 100
    
    return wt_composition


def wt_to_at(wt_composition: Dict[str, float]) -> Dict[str, float]:
    """
    Convert weight percent to atomic percent.
    
    Args:
        wt_composition: {'Fe': 61.4, 'Nd': 30.8, 'Co': 5.2}
    
    Returns:
        at_composition: {'Fe': 65.0, 'Nd': 30.0, 'Co': 5.0}
    """
    total_wt = sum(wt_composition.values())
    if abs(total_wt - 100) > 0.01:
        wt_composition = {k: v / total_wt * 100 for k, v in wt_composition.items()}
    
    # Calculate atom contribution of each element
    atom_contrib = {}
    total_atoms = 0.0
    for symbol, wt_pct in wt_composition.items():
        if symbol not in ATOMIC_WEIGHTS:
            raise ValueError(f"Unknown element: {symbol}")
        atoms = wt_pct / ATOMIC_WEIGHTS[symbol]
        atom_contrib[symbol] = atoms
        total_atoms += atoms
    
    # Convert to atomic percent
    at_composition = {}
    for symbol, atoms in atom_contrib.items():
        at_composition[symbol] = (atoms / total_atoms) * 100
    
    return at_composition


def parse_composition_with_unit(
    formula: str,
    unit: str = 'at%'
) -> Dict[str, float]:
    """
    Parse a formula string and return atomic percent (always at% for DB).
    
    Args:
        formula: String like 'Fe65Nd30Co5'
        unit: 'at%' or 'wt%' - what the input numbers represent
    
    Returns:
        Atomic percent dict (always at%)
    """
    # Parse the raw numbers
    raw = parse_composition_input(formula, unit=unit)
    
    if unit.lower() == 'wt%':
        # Input is in weight %, convert to atomic %
        return wt_to_at(raw)
    else:
        # Input is already atomic %
        return raw

# Test
if __name__ == "__main__":
    # Test at% → wt% conversion
    at_comp = {'Fe': 65.0, 'Nd': 30.0, 'Co': 5.0}
    wt_comp = at_to_wt(at_comp)
    print(f"at%: {at_comp}")
    print(f"wt%: {wt_comp}")
    
    # Test wt% → at% conversion (should reverse)
    at_back = wt_to_at(wt_comp)
    print(f"back to at%: {at_back}")

