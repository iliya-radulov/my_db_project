# ============================================
# NEW: String parser for formula input
# ============================================

def parse_formula(formula: str) -> Dict[str, float]:
    """
    Parse a formula string like 'Fe65Nd30Co5' into atomic percent dict.
    
    Returns: {'Fe': 65.0, 'Nd': 30.0, 'Co': 5.0}
    """
    import re
    
    # Find all element symbols and their percentages
    # Pattern: uppercase letter, optional lowercase letter, then number
    pattern = r'([A-Z][a-z]?)(\d*\.?\d+)'
    matches = re.findall(pattern, formula)
    
    if not matches:
        raise ValueError(f"Could not parse formula: {formula}")
    
    result = {}
    for symbol, pct in matches:
        # Convert to float, default to 1.0 if no number
        value = float(pct) if pct else 1.0
        # Capitalize correctly (e.g., 'fe' → 'Fe')
        symbol = symbol.capitalize()
        result[symbol] = value
    
    # Normalize to sum to 100 if they don't already
    total = sum(result.values())
    if abs(total - 100) > 0.01:
        # Scale to 100%
        result = {k: v / total * 100 for k, v in result.items()}
    
    return result

# Quick test
if __name__ == "__main__":
    # Test string parser
    test_formula = 'Fe65Nd30Co5'
    parsed = parse_formula(test_formula)
    print(f"Parsed: {parsed}")

